{
  "name": "ecommerce-inngest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && node scripts/build.mjs && node scripts/generate-icons.mjs && node scripts/generate-static.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma db push --accept-data-loss && node prisma/seed.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "15.1.11",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-fast-marquee": "^1.6.5",
    "react-hot-toast": "^2.5.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "vitest": "^4.1.11"
  }
}
