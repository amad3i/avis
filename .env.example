# Источник данных проекта.
#   "mock" (по умолчанию) — заглушка: всё работает на захардкоженных данных
#   в памяти. БД НЕ нужна, проект собирается и хостится на Vercel БЕЗ ключей
#   Neon. Ниже можно вообще ничего не заполнять.
#   "db" — реальная база (PostgreSQL / Neon). Тогда обязательны DATABASE_URL,
#   AUTH_SECRET, ADMIN_PASSWORD, KITCHEN_PASSWORD. Деплой сам создаст таблицы и
#   зальёт дефолтное меню через prisma db push + seed.
DATA_MODE="mock"

# ---- Блок «db» (нужен ТОЛЬКО при DATA_MODE="db") ---------------------------

# База данных (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# При DATA_MODE="db" на деплое таблицы создаются автоматически (prisma db push), дефолтное меню подтягивается само; картинки добавляются в админке.

# Секрет для сессий админки/кухни.
# В mock-режиме можно не задавать (демо работает с дефолтным). В db-режиме обязателен.
AUTH_SECRET="change-me-to-random-string"

# Скрытые пути панелей (смени под клиента: /panel, /kitchen-hq и т.п.)
ADMIN_PATH="panel"
KITCHEN_PATH="kitchen"

# Пароли входа.
# В mock-режиме дефолты: admin / kitchen (используются, если не заданы).
# В db-режиме обязательны.
ADMIN_PASSWORD="admin123"
KITCHEN_PASSWORD="kitchen123"

